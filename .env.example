# Copy this file to .env and fill in your key.
GEMINI_API_KEY=your_google_ai_studio_key_here

# Optional: override the Gemini model (defaults to gemini-2.0-flash).
# GEMINI_MODEL=gemini-2.0-flash

# Optional: free-tier requests-per-minute cap. The scorer self-throttles to
# stay under it. Leave unset (or 0) to disable throttling on a paid plan.
# GEMINI_MAX_RPM=5

# Optional: attempts per Gemini call (1 = no retry). Each retry is a billable
# request, so keep at 1 on free tier's tiny daily quota; raise on a paid plan.
# GEMINI_MAX_RETRIES=1

# Existing authenticated API: required Postgres / Supabase connection string.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Optional server-owned key for existing public chat; never put this in a JS bundle.
# TRUSTLAYER_CHAT_KEY=tl_server_owned_key
# Optional existing fallback model/key configuration (keys 2 through 9 supported).
# GEMINI_API_KEY_2=your_second_project_key
# GEMINI_FALLBACK_MODELS=your_fallback_model
# GEMINI_CHAT_MODEL=your_chat_model
# FREE_TIER_DAILY_LIMIT=10

# --------------------------------------------------------------------------- #
# TrustLayer 2.0 verification (/v1/verify, /v1/verify/stream, /v1/status)
# Every key below is optional: without any, verification still runs its free
# deterministic checks (math, contradictions, certainty language, citations
# syntax) and reports every claim it could not research as UNVERIFIED.
# --------------------------------------------------------------------------- #

# Claim extraction cap (1..200); request text is capped at 24,000 characters.
TRUSTLAYER_CLAIM_MAX_CLAIMS=80

# --- Search providers (evidence retrieval) ---
# Brave Search API (web results; ~$5 per 1,000 requests on the Search plan, with
# $5/month free credit as of Oct 2026 — check your plan). Leave unset to disable.
# BRAVE_SEARCH_API_KEY=your_brave_key
# Contact URL or email sent in the User-Agent. Wikimedia REQUIRES it, so
# Wikipedia search is disabled until this is set. Also used for OpenAlex's polite pool.
# TRUSTLAYER_CONTACT=https://github.com/your-org/your-repo
# TRUSTLAYER_ENABLE_WIKIPEDIA=true
# TRUSTLAYER_ENABLE_OPENALEX=true

# --- AI judges (read passages; never decide verdicts) ---
# Order of preference; a judge from a different family than the response's
# source_model is preferred ("never let a model judge itself").
# TRUSTLAYER_LLM_PROVIDERS=anthropic,gemini
# ANTHROPIC_API_KEY=your_anthropic_key
# ANTHROPIC_MODEL=claude-opus-5-5
# TRUSTLAYER_ANTHROPIC_EFFORT=low
# Gemini judge reuses GEMINI_API_KEY (and _2.._9 for quota rotation) from above.
# TRUSTLAYER_GEMINI_MODEL=gemini-2.5-flash-lite

# --- Page fetching (SSRF-safe) ---
# TRUSTLAYER_FETCH_ALLOWED_PORTS=80,443
# TRUSTLAYER_RESPECT_ROBOTS=true

# --- Budgets per mode: TRUSTLAYER_<QUICK|DEEP>_<LIMIT> ---
# Limits: MAX_SECONDS, MAX_SEARCH_CALLS, MAX_PAGE_FETCHES, MAX_MODEL_CALLS,
# MAX_MODEL_TOKENS, MAX_COST_USD, MAX_CLAIMS_INVESTIGATED, MAX_QUERIES_PER_CLAIM,
# MAX_RESULTS_PER_QUERY, MAX_PAGES_PER_CLAIM. Defaults: quick 25 s / $0.10,
# deep 90 s / $1.00. Invalid values make the verify routes return 503 (fail closed).
# TRUSTLAYER_QUICK_MAX_COST_USD=0.10
# TRUSTLAYER_DEEP_MAX_COST_USD=1.00
# Price overrides for cost estimates (USD): per search call, per million tokens.
# TRUSTLAYER_PRICE_SEARCH_BRAVE=0.005
# TRUSTLAYER_PRICE_MODEL_INPUT_PER_MTOK=4.00
# TRUSTLAYER_PRICE_MODEL_OUTPUT_PER_MTOK=20.00

# --- Policy, capacity, privacy ---
# Evidence older than this cannot decide a time-sensitive claim (1..3650 days).
# TRUSTLAYER_FRESHNESS_DAYS=365
# Concurrent verifications per process (1..64; keep <= ~30 with the default threadpool).
# TRUSTLAYER_MAX_CONCURRENT_VERIFICATIONS=4
# Hours to keep reports for GET/DELETE /v1/reports/{id}. 0 = never stored (default).
# TRUSTLAYER_REPORT_RETENTION_HOURS=0
# Comma-separated allowed browser origins; "*" keeps the permissive default.
# TRUSTLAYER_CORS_ORIGINS=https://your-frontend.example.com
# Keyless public chat stores raw text for training unless set to false.
# TRUSTLAYER_PUBLIC_CHAT_LOG_INPUTS=true

# --- Website (frontend/site): POST /v1/leads and POST /v1/demo/verify/stream ---
# The site's live demo is OFF unless this is on. It runs Quick Checks with this server's
# provider keys and stores nothing; when off, the site replays labelled recordings instead.
# TRUSTLAYER_PUBLIC_DEMO=true
# Demo runs allowed per day across all visitors (each visitor also gets 5 a day).
# Free-tier model keys run out fast: keep this small or use a paid key.
# TRUSTLAYER_DEMO_DAILY_LIMIT=100
# Salt for the one-way IP hash kept with sign-ups (spam and rate limits). Without it a
# random salt is made at startup, so hashes stop matching after every restart.
# TRUSTLAYER_IP_SALT=a-long-random-string
# The site's origin must be allowed in TRUSTLAYER_CORS_ORIGINS above when it is hosted
# on another domain. The site itself reads VITE_API_BASE, SITE_URL, VITE_CONTACT_EMAIL and
# VITE_ANALYTICS_DOMAIN (cookie-free Plausible; off when unset) at build time
# (see frontend/site/README.md).

# Standalone research collection (research/collect.py). No scoring is called.
# Keys already declared above (GEMINI_API_KEY, ANTHROPIC_API_KEY) are reused.
# OPENAI_API_KEY=your_openai_key
# GROQ_API_KEY=your_groq_key
# TOGETHER_API_KEY=your_together_key
